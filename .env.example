# Скопіюй у .env і заповни:  cp .env.example .env

# --- Авторизація Claude Code (потрібне ОДНЕ з двох) ---
# API-ключ з console.anthropic.com
ANTHROPIC_API_KEY=
# або токен підписки Claude Pro/Max: виконай `claude setup-token` на Mac
CLAUDE_CODE_OAUTH_TOKEN=

# --- Jira MCP (mcp-atlassian): Claude Code працює з Jira через нього ---
JIRA_URL=https://your-domain.atlassian.net
# Jira Cloud: email + API token
# Створити токен: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
# Jira Server / Data Center: замість двох рядків вище — Personal Access Token
# JIRA_PERSONAL_TOKEN=

# --- Папка на Mac з git-репозиторіями (монтується в /workspaces) ---
REPOS_DIR=~/Projects

# --- Автор git-комітів (від чийого імені комітять оркестратор і агенти) ---
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=you@example.com
